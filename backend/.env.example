APP_NAME=YGO Deck Helper API
DEBUG=true
CORS_ORIGINS=http://localhost:3000
# LM_STUDIO_CONFIG_PATH=/absolute/path/to/agents/config/lm_studio.json

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2001
POSTGRES_DB=ygo-helper

# YGOPRODeck sync (tùy chọn)
# YGOPRODECK_API_BASE=https://db.ygoprodeck.com/api/v7
# CARD_IMAGES_DIR=/absolute/path/to/backend/storage/cards
# CARD_SYNC_PAGE_SIZE=100
# CARD_SYNC_REQUEST_DELAY_MS=100

# RAG Rulebook (LM Studio embedding + pgvector)
# RAG_EMBEDDING_MODEL=text-embedding-embeddinggamma-300m-qat
# RAG_EMBEDDING_DIMENSION=768

# Tab thử nghiệm (AgentScope + Gemma)
# LAB_CHAT_MODEL=google/gemma-4-e4b

# Phân tích câu hỏi trước agent trả lời (QueryAnalyzer)
# QUERY_ANALYZER_ENABLED=true
